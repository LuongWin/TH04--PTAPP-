{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      ".indexOn": ["fullName"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['fullName', 'email', 'createdAt'])",
        "fullName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100 && newData.val().replace(' ', '').replace('\\t', '').replace('\\n', '').replace('\\r', '').replace(' ', '').length > 0 && !newData.val().contains('\\n') && !newData.val().contains('\\r')"
        },
        "email": {
          ".validate": "newData.isString() && newData.val() === auth.token.email"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === now) || (data.exists() && newData.val() === data.val()))"
        },
        "avatarUrl": {
          ".validate": "newData.isString() && newData.val().length <= 2048"
        },
        "$other": { ".validate": false }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "connections": {
          "$connectionId": { ".validate": "newData.val() === true" }
        },
        "lastOnline": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$other": { ".validate": false }
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && (data.child('memberA').val() === auth.uid || data.child('memberB').val() === auth.uid)",
        ".write": "auth != null && !data.exists() && newData.exists() && (newData.child('memberA').val() === auth.uid || newData.child('memberB').val() === auth.uid)",
        ".validate": "newData.hasChildren(['memberA', 'memberB', 'createdAt']) && newData.child('memberA').val() !== newData.child('memberB').val()",
        "memberA": {
          ".validate": "newData.isString() && root.child('users').child(newData.val()).exists()"
        },
        "memberB": {
          ".validate": "newData.isString() && root.child('users').child(newData.val()).exists()"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": { ".validate": false }
      }
    },
    "messages": {
      "$chatId": {
        ".read": "auth != null && (root.child('chats').child($chatId).child('memberA').val() === auth.uid || root.child('chats').child($chatId).child('memberB').val() === auth.uid)",
        ".indexOn": ["createdAt"],
        "$messageId": {
          ".write": "auth != null && !data.exists() && newData.exists() && newData.child('senderId').val() === auth.uid && (root.child('chats').child($chatId).child('memberA').val() === auth.uid || root.child('chats').child($chatId).child('memberB').val() === auth.uid)",
          ".validate": "newData.hasChildren(['senderId', 'text', 'createdAt'])",
          "senderId": { ".validate": "newData.val() === auth.uid" },
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4000 && newData.val().replace(' ', '').replace('\\t', '').replace('\\n', '').replace('\\r', '').replace(' ', '').length > 0"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "location": {
            ".validate": "newData.hasChildren(['latitude', 'longitude'])",
            "latitude": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "longitude": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$chatId": {
          ".write": "auth != null && newData.val() === true && (root.child('chats').child($chatId).child('memberA').val() === auth.uid || root.child('chats').child($chatId).child('memberB').val() === auth.uid) && (root.child('chats').child($chatId).child('memberA').val() === $uid || root.child('chats').child($chatId).child('memberB').val() === $uid)",
          ".validate": "newData.val() === true"
        }
      }
    },
    "messageReads": {
      "$chatId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid && (root.child('chats').child($chatId).child('memberA').val() === auth.uid || root.child('chats').child($chatId).child('memberB').val() === auth.uid)",
          "$messageId": {
            ".write": "auth != null && auth.uid === $uid && newData.val() === true && root.child('messages').child($chatId).child($messageId).exists() && (root.child('chats').child($chatId).child('memberA').val() === auth.uid || root.child('chats').child($chatId).child('memberB').val() === auth.uid)",
            ".validate": "newData.val() === true"
          }
        }
      }
    },
    "$other": { ".validate": false }
  }
}
